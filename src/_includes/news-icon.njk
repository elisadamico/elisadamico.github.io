{#- Small icon for a news card. Set "kind" before including: article, event, report, or award. -#}
{%- if kind == "article" -%}<svg class="news-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 1.5h5.5L13 5v9.5H4z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9.5 1.5V5H13M6 8h5M6 10.5h5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
{%- elif kind == "report" -%}<svg class="news-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="2" width="11" height="12.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5 11V8.5M8 11V6M11 11V7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
{%- elif kind == "award" -%}<svg class="news-icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="6" r="4" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 9.3 4.5 15 8 13.2 11.5 15l-1-5.7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
{%- else -%}<svg class="news-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="11.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
{%- endif -%}